   "source": [
    "from langchain_core.prompts import PromptTemplate\n",
    "from langchain_text_splitters import RecursiveCharacterTextSplitter\n",
    "from langchain_community.vectorstores import FAISS\n",
    "from langchain_community.document_loaders import YoutubeLoader\n",
    "from langchain_huggingface import ChatHuggingFace, HuggingFaceEndpoint, HuggingFaceEmbeddings\n",
    "from langchain_core.runnables import RunnablePassthrough,RunnableParallel,RunnableLambda\n",
    "from langchain_core.output_parsers import StrOutputParser\n",
    "from dotenv import load_dotenv\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fb59569d",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "os.environ['HUGGINGFACEHUB_API_TOKEN']= \"your_huggingfacehub_api_token\""
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4b558bd5",
   "metadata": {},
   "source": [
    "# Step 1a- Indexing (Document Ingestion in the vector Store)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "feaf453a",
   "metadata": {},
   "outputs": [],
   "source": [
    "yt_url = input(\"enter the youtube URL:\")\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "49f3a70a",
   "metadata": {},
   "outputs": [],
   "source": [
    "loader = YoutubeLoader.from_youtube_url(yt_url, add_video_info=False, language=['en'])\n",
    "\n",
    "transcript = loader.load()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "045ce0ab",
   "metadata": {},
   "source": [
    "# Text splitting for chunking the document into smaller pieces"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "2cf285e1",
   "metadata": {},
   "outputs": [],
   "source": [
    "splitter = RecursiveCharacterTextSplitter(\n",
    "    chunk_size=1000,\n",
    "    chunk_overlap=200,\n",
    "    \n",
    ")\n",
    "\n",
    "chunks = splitter.split_documents(transcript)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5707b71e",
   "metadata": {},
   "source": [
    "# Creating the Vector Store\n",
    "## Step 1c & 1d - Indexing (Embedding Generation and Storing in Vector Store)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "50243395",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n",
      "Loading weights: 100%|██████████| 103/103 [00:00<00:00, 6807.33it/s]\n"
     ]
    }
   ],
   "source": [
    "embeddings = HuggingFaceEmbeddings(model_name = \"sentence-transformers/all-MiniLM-L6-v2\")\n",
    "vectorstore = FAISS.from_documents(chunks , embeddings)"
   ]
  },
